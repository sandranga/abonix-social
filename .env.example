# Copy to .env and fill in. Never commit .env.

# --- Safety -------------------------------------------------------------
# true = the whole flow runs (generate, Telegram approval, schedule) but
# nothing is sent to Facebook/Instagram. Set false only after `meta-check`
# and `meta-test` pass.
DRY_RUN=true
PUBLISH_TARGETS=facebook,instagram

# --- Schedule (Europe/Bucharest) ---------------------------------------
TIMEZONE=Europe/Bucharest
GENERATE_TIME=08:00
PUBLISH_TIME=18:30

# --- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
CLAUDE_REVIEW_MODEL=claude-haiku-5-5
CLAUDE_FALLBACKS=true

# --- Stock photos for Thursday posts -----------------------------------------
# Pixabay: free key at https://pixabay.com/api/docs/ (sign up, key is shown there).
# A Pexels key also works if you already have one; Pixabay wins if both are set.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Telegram ----------------------------------------------------------------
# From @BotFather. Then send /start to the bot: it replies with your chat id.
# Put it below and run `docker compose up -d --force-recreate` (not `restart`, which keeps the old .env).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Meta Graph API ----------------------------------------------------------
# System User token (never expires) with: pages_show_list, pages_read_engagement,
# pages_manage_posts, instagram_basic, instagram_content_publish, business_management
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# --- Media hosting: Cloudflare R2 (bucket with custom domain media.abonix.net)
STORAGE_BACKEND=r2
MEDIA_PUBLIC_BASE_URL=https://media.abonix.net
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=abonix-social
